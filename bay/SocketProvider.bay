namespace Runtime.Web;

use Runtime.BaseDTO;
use Runtime.BaseProvider;
use Runtime.Web.Socket;


class SocketProvider extends BaseProvider
{
	/**
	 * Add websocket url
	 */
	static string url() => "";
	
	
	/**
	 * Connected
	 */
	async void connected(Socket socket)
	{
	}
	
	
	/**
	 * Disconnected
	 */
	async void disconnected(Socket socket)
	{
	}
	
	
	/**
	 * On message
	 */
	async void onMessage(Socket socket, BaseDTO message)
	{
		if (message instanceof Map and message.get("command") == "ping")
		{
			await socket.send({"command": "pong"});
		}
	}
}