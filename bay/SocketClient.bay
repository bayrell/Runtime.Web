namespace Runtime.Web;

use Runtime.BaseObject;
use Runtime.BaseDTO;
use Runtime.Serializer.ObjectType;


class SocketClient extends BaseObject
{
	string url = "";
	ObjectType rules = new ObjectType();
	var instance = null;
	var onDisconnect = null;
	var onMessage = null;
	var timer = null;
	int timer_timeout = 25000;
	
	
	/**
	 * Constructor
	 */
	void constructor(string url)
	{
		parent();
		this.url = url;
		this.rules = new ObjectType{
			"extends": classof BaseDTO,
			"autocreate": true,
		};
	}
	
	
	/**
	 * Connect
	 */
	void connect()
	{
		#ifcode JAVASCRIPT then
		this.instance = new WebSocket(this.url);
		this.instance.onclose = this.socketDisconnect.bind(this);
		this.instance.onmessage = this.socketMessage.bind(this);
		this.timer = setInterval(
			this.ping.bind(this), this.timer_timeout
		);
		#endif
	}
	
	
	/**
	 * Disconnect
	 */
	void socketDisconnect()
	{
		if (this.onDisconnect) this.onDisconnect.apply();
		if (this.timer)
		{
			window.clearInterval(this.timer);
			this.timer = null;
		}
	}
	
	
	/**
	 * Send ping
	 */
	async void ping()
	{
		await this.send({"command": "ping"});
	}
	
	
	/**
	 * Message
	 */
	void socketMessage(var event)
	{
		Map data = rtl::jsonDecode(event.data);
		BaseDTO item = this.rules.filter(data, []);
		if (this.onMessage) this.onMessage.apply([item ? item : data]);
	}
	
	
	/**
	 * Send data
	 */
	async void send(BaseDTO item)
	{
		Map data = null;
		
		if (item instanceof Map)
		{
			data = item;
		}
		else
		{
			data = rtl::serialize(item);
			data.set("__class_name__", item::getClassName());
		}
		
		this.instance.send(rtl::jsonEncode(data));
	}
}